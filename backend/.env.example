# Copy to .env and replace all placeholder values before starting the backend.
# Local development URL. Docker Compose overrides DATABASE_URL at runtime.
# URL-encode the password if it contains URL-reserved characters.
DATABASE_URL="mysql+pymysql://lab_user:CHANGE_ME_DB_PASSWORD@127.0.0.1:3306/lab_agent?charset=utf8mb4"

# Generate your own random secret; do not use this placeholder as a real secret.
JWT_SECRET_KEY="CHANGE_ME_GENERATE_A_RANDOM_SECRET"
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM="HS256"

# Chat Completions-compatible service with tool calling and streaming support.
# Docker Compose sets LLM_BASE_URL in compose.yaml.
LLM_API_KEY="YOUR_LLM_API_KEY"
LLM_MODEL="YOUR_TOOL_CALLING_MODEL"
LLM_BASE_URL="https://YOUR_LLM_HOST/v1"
